# Husnalogy STAGING environment — template only. Copy to `.env.staging`
# (git-ignored) and fill in a DEDICATED, disposable Supabase project that holds
# NO real customer data. Never reuse production keys here.
#
# Every staging tool (npm run staging:migrate | staging:seed | test:staging |
# test:e2e:staging) reads ONLY this file and REFUSES to run when the project
# is a known production ref, is the project in .env.local, or is not confirmed
# below. Setup: docs/E2E_STAGING.md · audit: docs/SUPABASE_STAGING_AUDIT.md

# --- Staging Supabase project (Project Settings → API / Connect) -----------
NEXT_PUBLIC_SUPABASE_URL=https://<staging-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# secret — server only
SUPABASE_SERVICE_ROLE_KEY=
# Session pooler (port 5432) or direct connection; must contain <staging-ref>.
STAGING_DATABASE_URL=postgresql://postgres.<staging-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Type the ref again after checking in the dashboard that this IS staging.
STAGING_CONFIRM_PROJECT_REF=<staging-ref>

# --- Seed (npm run staging:seed) -------------------------------------------
# >= 12 characters; shared by the synthetic admin/designer/customer accounts.
CUSTOMIZER_SEED_PASSWORD=
CUSTOMIZER_SEED_EMAIL_PREFIX=customizer-e2e
CUSTOMIZER_SEED_EMAIL_DOMAIN=example.test

# --- Application (staging values, never production ones) ------------------
# The staging deployment origin (https), or leave the default for a local server.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3200
# >= 32 characters, unique to staging (openssl rand -hex 32)
CRON_SECRET=
GOOGLE_FONTS_API_KEY=
# Resend TEST key or empty (emails then wait as deferred tasks). Never real customers.
RESEND_API_KEY=
EMAIL_FROM=
# Fixture pages are allowed on staging only.
ENABLE_CUSTOMIZER_E2E_FIXTURE=1

# --- Playwright (npm run test:e2e:staging) ---------------------------------
# Empty = a fresh local server on port 3200 with these variables.
E2E_BASE_URL=

# --- Disaster-recovery drill INTO staging (optional) -----------------------
# docs/HUSNALOGY_DISASTER_RECOVERY.md. Restores refuse production and require
# this confirmation to equal the staging ref.
RESTORE_CONFIRM_TARGET=
