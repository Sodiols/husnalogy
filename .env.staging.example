# Husnalogy STAGING environment (copy to .env.staging — git-ignored).
# Use a DEDICATED, DISPOSABLE Supabase project. Never the live project, never
# real customers. Staging tools refuse production project refs and the
# project configured in .env.local. No real values belong in this template.

# ------------------------------------------------------------- Supabase --
# Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<staging-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase dashboard → Connect → "Session pooler" (or direct) connection string,
# used to apply migrations and run the real-database checks. Must contain the ref.
STAGING_DATABASE_URL=postgresql://postgres.<staging-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Type the staging project ref again to confirm it is the disposable project.
STAGING_CONFIRM_PROJECT_REF=<staging-ref>

# ------------------------------------------------------------- E2E seed --
# Password for the seeded e2e accounts (12+ characters). Accounts are
#   <prefix>+admin@<domain>, <prefix>+customer-a@<domain>, <prefix>+customer-b@<domain>
CUSTOMIZER_SEED_PASSWORD=
CUSTOMIZER_SEED_EMAIL_PREFIX=husnalogy-e2e
CUSTOMIZER_SEED_EMAIL_DOMAIN=example.test

# --------------------------------------------------------- App for E2E --
# Leave E2E_BASE_URL empty to run a local production build against staging;
# or set it to a staging deployment of THIS build (with
# ENABLE_CUSTOMIZER_E2E_FIXTURE=1 there).
E2E_BASE_URL=
# The site origin the staging app is built/started with.
NEXT_PUBLIC_SITE_URL=https://staging.husnalogy.com
GOOGLE_FONTS_API_KEY=
# 32+ characters (openssl rand -hex 32). Used by the worker steps of the suite.
CRON_SECRET=

# Optional: the seeded accounts are read from .customizer-e2e.json, these
# override them. E2E_CUSTOMER_* is Customer A.
# E2E_CUSTOMER_EMAIL= / E2E_CUSTOMER_PASSWORD=
# E2E_CUSTOMER_B_EMAIL= / E2E_CUSTOMER_B_PASSWORD=
# E2E_ADMIN_EMAIL= / E2E_ADMIN_PASSWORD=
