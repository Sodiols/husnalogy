{
  "name": "husnalogy-nextjs",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --max-http-header-size=65536 node_modules/next/dist/bin/next dev -H 0.0.0.0",
    "build": "npm run validate:fonts && npm run repair:next-types && next build --webpack",
    "validate:fonts": "node scripts/validate-customizer-fonts.mjs",
    "repair:next-types": "node scripts/repair-next-types.mjs",
    "validate:customizer:database": "node scripts/validate-customizer-database.mjs",
    "generate:customizer:schema": "node scripts/generate-customizer-schema.mjs",
    "generate:customizer:types": "node scripts/generate-customizer-types.mjs",
    "audit:customizer": "node scripts/audit-customizer-files.mjs",
    "lint": "eslint .",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test e2e/public-build-smoke.spec.ts",
    "seed:customizer:test": "node scripts/seed-customizer-test.mjs",
    "pretypecheck": "npm run repair:next-types",
    "typecheck": "tsc --noEmit",
    "staging:migrate": "node scripts/staging/apply-migrations.mjs",
    "staging:seed": "node scripts/staging/seed.mjs",
    "test:staging": "node scripts/staging/test-staging.mjs",
    "test:e2e:staging": "node scripts/staging/run-e2e.mjs",
    "check:clock": "node scripts/check-clock.mjs",
    "benchmark:render-limits": "node scripts/benchmark-render-limits.mjs"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.57.4",
    "@tailwindcss/postcss": "4.3.0",
    "konva": "^10.3.1",
    "next": "16.3.8",
    "openai": "6.42.0",
    "opentype.js": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-konva": "^19.2.5",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.61.1",
    "@types/node": "25.9.3",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.17",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "pg": "8.23.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
