# Husnalogy environment variables.
# Copy to .env.local for development. Never commit real values.
# Production (Hostinger): see HOSTINGER_DEPLOYMENT.md. `npm start` refuses to
# boot in production when a REQUIRED variable below is missing or invalid.
#
# NEXT_PUBLIC_* variables are inlined into the browser bundle and are PUBLIC.
# Everything else is server-only and must never gain a NEXT_PUBLIC_ prefix.

# ---------------------------------------------------------------- Supabase --
# REQUIRED. Public (safe in the browser; protected by Row Level Security).
# Also needed at BUILD time: inlined into the bundle, and its host is the only
# Supabase host allowed to serve images.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# REQUIRED SERVER SECRET — bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------- Fonts --
# REQUIRED SERVER SECRET. Google Fonts Developer API key, used only on the server to
# fetch the font catalog (https://developers.google.com/fonts/docs/developer_api).
# Sent as an x-goog-api-key request header, never as a URL parameter, so it
# cannot leak through logs or error messages. The browser never receives it:
# the sanitized catalog is served by GET /api/customizer/fonts instead.
#
# Required for the customizer's font selector and for production PNG/PDF
# rendering. Without it the storefront still works, but the font selector
# reports that Google Fonts are unavailable and print rendering fails loudly
# rather than substituting a different typeface.
GOOGLE_FONTS_API_KEY=

# ------------------------------------------------------------------ Render --
# REQUIRED SERVER SECRET (at least one, 32+ chars: openssl rand -hex 32).
# Authorizes the render worker at /api/admin/customizer/render/process.
# Send either value as `Authorization: Bearer <secret>` or `x-render-secret`.
# On Hostinger this is called by an hPanel cron job (HOSTINGER_DEPLOYMENT.md §5).
CRON_SECRET=
RENDER_WORKER_SECRET=

# --------------------------------------------------------------- App / SEO --
# REQUIRED. Public. Canonical site origin used for metadata, sitemap, robots
# and auth redirects. Production: https://husnalogy.com (https, never localhost).
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------- Storage ---
# Informational. Supabase Storage is always used.
STORAGE_DRIVER=supabase

# ----------------------------------------------------------- Rate limiting --
# Optional SERVER SECRETS. When both are set, the highest-value endpoints use a
# globally-shared Upstash Redis limiter; without them the per-instance
# in-memory limiter is used instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------- AI (Ask Logy) --
# Optional SERVER SECRET. Ask Logy falls back to its local answer set when
# absent.
OPENAI_API_KEY=
OPENAI_MODEL=
LOGY_USE_OPENAI=

# ----------------------------------------------------------- Customizer -----
# Optional SERVER configuration. Upstream origin for Iconify element discovery.
# Defaults to the public API; NO API KEY IS REQUIRED OR SUPPORTED.
# Point this at a self-hosted Iconify instance (e.g. https://icons.husnalogy.com)
# to remove the public-API dependency without any customizer changes.
# Iconify is used only to DISCOVER and IMPORT graphics: imported elements are
# sanitized and stored permanently by Husnalogy, so saved designs, orders and
# production rendering never contact Iconify.
ICONIFY_API_BASE_URL=

# ------------------------------------------------- Permanent deletion (§27) --
# SERVER SECRETS. Required ONLY to enable permanent product deletion; the
# feature stays disabled (and the control hidden) when either is absent, which
# is the safe default. Re-authenticates the admin at the moment of an
# irreversible delete, so a borrowed session cannot destroy the catalogue.
# Admin-only. A designer can never reach this route.
DELETE_ADMIN_EMAIL=
DELETE_ADMIN_PASSWORD=

# ------------------------------------------------------- Test fixtures -------
# DEVELOPMENT / STAGING ONLY. The customizer E2E fixture routes
# (/__e2e/customizer, /__e2e/admin-canvas) mount the real editors against an
# in-memory document with no database, auth or remote assets.
#
# They are always available in non-production builds and return 404 in a
# production build unless this is set to 1. Set it on a STAGING deployment to
# run the browser suite there; never set it on the live site.
ENABLE_CUSTOMIZER_E2E_FIXTURE=
